<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="sidebar" prefWidth="230.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
   <children>
      <Label fx:id="loggedUserLabel" text="Login sebagai: -" styleClass="user-label" wrapText="true"/>
      
      <VBox spacing="6.0" styleClass="menu-section">
         <Label text="Navigasi Pelanggan" styleClass="menu-header"/>
         <Button text="Beranda" onAction="#handleShowBeranda" maxWidth="Infinity" styleClass="menu-button"/>
         <Button text="Cari Film" onAction="#showCariFilmView" maxWidth="Infinity" styleClass="menu-button"/>
         <Button text="Form Pemesanan" onAction="#showPemesananView" maxWidth="Infinity" styleClass="menu-button"/>
         <Button text="Riwayat Pemesanan" onAction="#showRiwayatView" maxWidth="Infinity" styleClass="menu-button"/>
      </VBox>
      
      <VBox spacing="5.0" styleClass="menu-section" VBox.vgrow="ALWAYS" alignment="BOTTOM_CENTER">
         <children>
            <Button text="Logout" onAction="#handleLogout" maxWidth="Infinity" styleClass="logout-button"/>
         </children>
      </VBox>
   </children>
</VBox>