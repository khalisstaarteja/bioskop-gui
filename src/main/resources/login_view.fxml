<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane stylesheets="@css/style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
           fx:controller="main.java.controller.LoginController">
    
    <!-- Form Login (Admin & Pelanggan dengan Role Selector) -->
    <GridPane fx:id="loginPane" alignment="CENTER" hgap="10" vgap="15" styleClass="login-container" maxWidth="380" maxHeight="370">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        
        <Label text="Login Sistem Bioskop" style="-fx-font-size: 20px; -fx-font-weight: bold;" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
        
        <Label text="Login Sebagai:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="loginRoleComboBox" promptText="-- Pilih Role --" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label fx:id="identifierLabel" text="Username / Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameOrEmailField" promptText="Masukkan username atau email" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" promptText="Masukkan password" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Button text="Sign In" onAction="#handleLogin" styleClass="button-primary" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnSpan="2"/>

        <HBox alignment="CENTER" spacing="5" GridPane.rowIndex="5" GridPane.columnSpan="2">
            <Label text="Pelanggan baru?" />
            <Hyperlink text="Daftar Akun (Register)" onAction="#showRegisterForm" />
        </HBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: red;" wrapText="true" GridPane.rowIndex="6" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
    </GridPane>

    <!-- Form Register Pelanggan -->
    <GridPane fx:id="registerPane" visible="false" alignment="CENTER" hgap="10" vgap="15" styleClass="login-container" maxWidth="380" maxHeight="380">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        
        <Label text="Register Pelanggan" style="-fx-font-size: 20px; -fx-font-weight: bold;" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
        
        <Label text="Nama Lengkap:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="regNamaField" promptText="Masukkan nama" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="regEmailField" promptText="Masukkan email" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        
        <Label text="Password:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <PasswordField fx:id="regPasswordField" promptText="Buat password" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        
        <Button text="Daftar Sekarang" onAction="#handleRegister" styleClass="button-primary" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
        
        <HBox alignment="CENTER" spacing="5" GridPane.rowIndex="5" GridPane.columnSpan="2">
            <Label text="Sudah punya akun?" />
            <Hyperlink text="Kembali ke Login" onAction="#showLoginForm" />
        </HBox>

        <Label fx:id="regErrorLabel" style="-fx-text-fill: red;" wrapText="true" GridPane.rowIndex="6" GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
    </GridPane>

</StackPane>