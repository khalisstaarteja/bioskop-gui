<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.UserTableController">
    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
    <children>
        <VBox styleClass="form-card">
            <children>
                <GridPane hgap="15.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                        <ColumnConstraints minWidth="100.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="Nama:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="namaField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Password:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <PasswordField fx:id="passwordField" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="roleComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <!-- dynamic container untuk username admin / email pelanggan -->
                        <VBox fx:id="dynamicFormContainer" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="4" />

                        <HBox spacing="10.0" alignment="CENTER_RIGHT" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="3">
                            <Button onAction="#handleSubmit" styleClass="submit-btn" text="Submit" />
                            <Button onAction="#handleUpdate" styleClass="update-btn" text="Update" />
                            <Button onAction="#handleDelete" styleClass="delete-btn" text="Delete" />
                            <Button onAction="#clearForm" styleClass="clear-btn" text="Clear" />
                        </HBox>
                    </children>
                </GridPane>
            </children>
        </VBox>
        
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn text="ID"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
                <TableColumn text="Nama"><cellValueFactory><PropertyValueFactory property="nama" /></cellValueFactory></TableColumn>
                <TableColumn text="Role"><cellValueFactory><PropertyValueFactory property="role" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="extraColumn" text="Detail Spesifik" />
            </columns>
        </TableView>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button onAction="#handleViewDetails" text="View Details" />
        </HBox>
    </children>
</VBox>