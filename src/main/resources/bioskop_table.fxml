<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.BioskopTableController">
    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
    <children>
        <VBox styleClass="form-card">
            <children>
                <GridPane hgap="15.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                        <ColumnConstraints minWidth="100.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="Kode Bioskop:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="kodeBioskopField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="Nama Bioskop:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="namaBioskopField" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Lokasi:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="lokasiField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <HBox spacing="10.0" alignment="CENTER_RIGHT" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="1">
                            <Button onAction="#handleSubmit" styleClass="submit-btn" text="Submit" />
                            <Button onAction="#handleUpdate" styleClass="update-btn" text="Update" />
                            <Button onAction="#handleDelete" styleClass="delete-btn" text="Delete" />
                            <Button onAction="#clearForm" styleClass="clear-btn" text="Clear" />
                        </HBox>
                    </children>
                </GridPane>
            </children>
        </VBox>
        
        <TableView fx:id="bioskopTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn text="Kode Bioskop"><cellValueFactory><PropertyValueFactory property="kodeBioskop" /></cellValueFactory></TableColumn>
                <TableColumn text="Nama Bioskop"><cellValueFactory><PropertyValueFactory property="namaBioskop" /></cellValueFactory></TableColumn>
                <TableColumn text="Lokasi"><cellValueFactory><PropertyValueFactory property="lokasi" /></cellValueFactory></TableColumn>
            </columns>
        </TableView>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button onAction="#handleViewDetails" text="View Details" />
        </HBox>
    </children>
</VBox>