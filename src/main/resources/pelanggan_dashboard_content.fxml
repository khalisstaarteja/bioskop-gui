<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0"
      stylesheets="@/main/resources/css/style.css"
      styleClass="root"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.PelangganDashboardContentController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>
   <children>
      <VBox spacing="5.0">
         <Label text="Beranda Pelanggan" styleClass="page-title"/>
         <Label text="Jelajahi film terbaru dan lihat riwayat tiket bioskop Anda." styleClass="subtitle"/>
      </VBox>

      <!-- Carousel -->
      <VBox styleClass="card" spacing="15.0">
         <Label text="Film Terbaru Hanya di Bioskop Kami" styleClass="section-title"/>

         <HBox spacing="30.0" alignment="CENTER">
            <Button text="❮" onAction="#handlePrevMovie" styleClass="carousel-btn"/>

            <HBox spacing="20.0" alignment="CENTER">
               <StackPane styleClass="poster" prefWidth="130.0" prefHeight="180.0" minWidth="130.0" minHeight="180.0" maxWidth="130.0" maxHeight="180.0">
                  <ImageView fx:id="posterImageView" fitHeight="180.0" fitWidth="130.0" preserveRatio="false"/>
               </StackPane>

               <VBox spacing="8.0" alignment="CENTER_LEFT" prefWidth="250.0">
                  <Label fx:id="movieTitleLabel" text="Judul Film" styleClass="film-card-title"/>
                  <Label fx:id="movieGenreLabel" text="Genre &amp; Durasi" styleClass="film-card-meta" wrapText="true"/>
               </VBox>
            </HBox>

            <Button text="❯" onAction="#handleNextMovie" styleClass="carousel-btn"/>
         </HBox>
      </VBox>

      <!-- Statistik -->
      <VBox spacing="10.0">
         <Label text="Statistik Aktivitas Menonton Anda" styleClass="section-title"/>

         <HBox spacing="20.0">
            <children>
               <VBox styleClass="stat-card" prefWidth="240.0" spacing="5.0">
                  <Label text="Total Tiket Dibeli" styleClass="stat-title"/>
                  <Label fx:id="totalTiketSayaLabel" text="0 Tiket" styleClass="stat-value"/>
               </VBox>
            </children>
         </HBox>
      </VBox>
   </children>
</VBox>