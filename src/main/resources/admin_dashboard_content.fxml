<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@/main/resources/css/style.css" styleClass="root"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.AdminDashboardContentController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>
   <children>
      <VBox spacing="5.0">
         <Label text="Beranda Admin" styleClass="page-title"/>
         <Label text="Kelola data terkait dengan sistem bioskop." styleClass="subtitle"/>
      </VBox>

      <!-- Carousel film -->
      <VBox styleClass="card" spacing="15.0">
         <Label text="Film Yang Baru Ditambahkan" styleClass="section-title"/>

         <HBox spacing="30.0" alignment="CENTER">
            <children>
               <Button text="❮" onAction="#handlePrevMovie" styleClass="carousel-btn"/>

               <HBox fx:id="carouselBox" spacing="20.0" alignment="CENTER" prefHeight="200.0" prefWidth="600.0">
                  <StackPane styleClass="poster" prefWidth="130.0" prefHeight="180.0" minWidth="130.0" minHeight="180.0" maxWidth="130.0" maxHeight="180.0">
                     <ImageView fx:id="posterImageView" fitHeight="180.0" fitWidth="130.0" preserveRatio="false"/>
                  </StackPane>
                  <VBox alignment="CENTER_LEFT" spacing="8.0" prefWidth="250.0">
                     <Label fx:id="movieTitleLabel" text="Judul Film" styleClass="film-card-title"/>
                     <Label fx:id="movieGenreLabel" text="Genre &amp; Durasi" styleClass="film-card-meta" wrapText="true"/>
                  </VBox>
               </HBox>

               <Button text="❯" onAction="#handleNextMovie" styleClass="carousel-btn"/>
            </children>
         </HBox>
      </VBox>

      <!-- Statistik -->
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <Label text="Statistik Sistem Bioskop" styleClass="section-title"/>

         <HBox spacing="20.0">
            <VBox styleClass="stat-card" prefWidth="250.0" spacing="8.0">
               <Label text="Total Pendapatan" styleClass="stat-title"/>
               <Label fx:id="totalPendapatanLabel" text="Rp 0" styleClass="stat-value"/>
            </VBox>

            <VBox styleClass="stat-card" prefWidth="250.0" spacing="8.0">
               <Label text="Tiket Terjual" styleClass="stat-title"/>
               <Label fx:id="totalTiketLabel" text="0 Tiket" styleClass="stat-value"/>
            </VBox>

            <VBox styleClass="stat-card" prefWidth="250.0" spacing="8.0">
               <Label text="Total Film" styleClass="stat-title"/>
               <Label fx:id="totalFilmLabel" text="0 Film" styleClass="stat-value"/>
            </VBox>
         </HBox>
      </VBox>
   </children>
</VBox>