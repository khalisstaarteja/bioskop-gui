<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@/main/resources/css/style.css" styleClass="root"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.PemesananController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>
   <children>
      <Label text="Form Pemesanan Tiket Bioskop" styleClass="page-title"/>

      <!-- Form pemesanan (2 kolom) -->
      <VBox spacing="12.0" styleClass="form-card">
         <children>
            <GridPane hgap="20.0" vgap="14.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                  <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
               </columnConstraints>
               <children>
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <Label text="Pilih Bioskop:" styleClass="field-label"/>
                     <ComboBox fx:id="bioskopComboBox" promptText="-- Pilih Bioskop Terlebih Dahulu --" maxWidth="Infinity"/>
                  </VBox>

                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <Label text="Pilih Film:" styleClass="field-label"/>
                     <ComboBox fx:id="filmComboBox" promptText="-- Pilih Film --" maxWidth="Infinity"/>
                  </VBox>

                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <Label text="Pilih Jadwal Tayang &amp; Studio:" styleClass="field-label"/>
                     <ComboBox fx:id="jadwalComboBox" promptText="-- Pilih Jadwal --" maxWidth="Infinity"/>
                  </VBox>

                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <Label text="Jumlah Tiket:" styleClass="field-label"/>
                     <TextField fx:id="jumlahTiketField" promptText="Masukkan jumlah tiket"/>
                  </VBox>

                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                     <Label text="Metode Pembayaran:" styleClass="field-label"/>
                     <ComboBox fx:id="metodePembayaranComboBox" promptText="-- Pilih Metode Pembayaran --" maxWidth="Infinity"/>
                  </VBox>

                  <HBox alignment="BOTTOM_RIGHT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <Button text="Pesan Tiket Sekarang" onAction="#handlePesanTiket" styleClass="button-primary"/>
                  </HBox>
               </children>
            </GridPane>
         </children>
      </VBox>

      <!-- Riwayat / Tabel Pemesanan & Tombol Cetak -->
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <Label text="Riwayat Pemesanan Anda" styleClass="section-title"/>

         <TableView fx:id="riwayatTable" prefHeight="260.0" minHeight="200.0" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
               <TableColumn fx:id="idColumn" text="No. Pesanan" minWidth="100.0" prefWidth="100.0"/>
               <TableColumn fx:id="pelangganColumn" text="Pelanggan" minWidth="110.0" prefWidth="120.0"/>
               <TableColumn fx:id="filmColumn" text="Film" minWidth="160.0" prefWidth="180.0"/>
               <TableColumn fx:id="bioskopColumn" text="Bioskop" minWidth="100.0" prefWidth="120.0"/>
               <TableColumn fx:id="studioColumn" text="Studio" minWidth="80.0" prefWidth="80.0"/>
               <TableColumn fx:id="jadwalColumn" text="Jadwal Tayang" minWidth="170.0" prefWidth="170.0"/>
               <TableColumn fx:id="jumlahColumn" text="Jumlah" minWidth="70.0" prefWidth="70.0"/>
               <TableColumn fx:id="totalColumn" text="Total Bayar" minWidth="110.0" prefWidth="110.0"/>
               <TableColumn fx:id="metodeColumn" text="Pembayaran" minWidth="110.0" prefWidth="110.0"/>
            </columns>
         </TableView>

         <HBox alignment="CENTER_RIGHT">
            <Button text="Cetak / Lihat Struk Tiket" onAction="#handleCetakTiket" styleClass="button"/>
         </HBox>
      </VBox>
   </children>
</VBox>