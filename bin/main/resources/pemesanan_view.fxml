<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@../css/style.css" styleClass="root" 
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="main.java.controller.PemesananController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>
   <children>
      <Label text="Form Pemesanan Tiket Bioskop" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

      <!-- Bagian Form Input Pemesanan -->
      <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8;">
         <children>
            <!-- PILIH BIOSKOP -->
            <VBox spacing="5.0">
               <Label text="Pilih Bioskop:" style="-fx-font-weight: bold;"/>
               <ComboBox fx:id="bioskopComboBox" promptText="-- Pilih Bioskop Terlebih Dahulu --" prefWidth="400.0"/>
            </VBox>

            <!-- PILIH FILM -->
            <VBox spacing="5.0">
               <Label text="Pilih Film:" style="-fx-font-weight: bold;"/>
               <ComboBox fx:id="filmComboBox" promptText="-- Pilih Film --" prefWidth="400.0"/>
            </VBox>

            <!-- PILIH JADWAL -->
            <VBox spacing="5.0">
               <Label text="Pilih Jadwal Tayang &amp; Studio:" style="-fx-font-weight: bold;"/>
               <ComboBox fx:id="jadwalComboBox" promptText="-- Pilih Jadwal --" prefWidth="400.0"/>
            </VBox>

            <!-- JUMLAH TIKET -->
            <VBox spacing="5.0">
               <Label text="Jumlah Tiket:" style="-fx-font-weight: bold;"/>
               <TextField fx:id="jumlahTiketField" promptText="Masukkan jumlah tiket" prefWidth="400.0"/>
            </VBox>

            <!-- METODE PEMBAYARAN -->
            <VBox spacing="5.0">
               <Label text="Metode Pembayaran:" style="-fx-font-weight: bold;"/>
               <ComboBox fx:id="metodePembayaranComboBox" promptText="-- Pilih Metode Pembayaran --" prefWidth="400.0"/>
            </VBox>

            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
               <Button text="Pesan Tiket Sekarang" onAction="#handlePesanTiket" styleClass="button" style="-fx-background-color:rgb(0, 0, 0);"/>
            </HBox>
         </children>
      </VBox>

      <!-- Bagian Riwayat / Tabel Pemesanan & Tombol Cetak -->
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <Label text="Riwayat Pemesanan Anda" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
         
         <TableView fx:id="riwayatTable" prefHeight="200.0" VBox.vgrow="ALWAYS">
           <columns>
             <TableColumn fx:id="filmColumn" text="Judul Film" prefWidth="200.0"/>
             <TableColumn fx:id="jadwalColumn" text="Jadwal Tayang" prefWidth="180.0"/>
             <TableColumn fx:id="jumlahColumn" text="Jumlah" prefWidth="80.0"/>
             <TableColumn fx:id="totalColumn" text="Total Bayar" prefWidth="140.0"/>
           </columns>
         </TableView>

         <HBox alignment="CENTER_RIGHT">
            <Button text="Cetak / Lihat Struk Tiket" onAction="#handleCetakTiket" styleClass="button" style="-fx-background-color:rgb(0, 0, 0);"/>
         </HBox>
      </VBox>
   </children>
</VBox>