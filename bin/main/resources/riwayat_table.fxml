<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>

<VBox spacing="15.0" stylesheets="@/main/resources/css/style.css" styleClass="root"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.RiwayatController">
   <padding>
      <Insets top="20" right="20" bottom="20" left="20"/>
   </padding>
   <children>
      <Label text="Riwayat Pemesanan Tiket Anda" styleClass="page-title"/>

      <TableView fx:id="riwayatTable" VBox.vgrow="ALWAYS" prefHeight="400.0">
         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
         <columns>
            <TableColumn fx:id="nomorColumn" text="No. Pesanan" prefWidth="90.0"/>
            <TableColumn fx:id="filmColumn" text="Film" prefWidth="170.0"/>
            <TableColumn fx:id="bioskopColumn" text="Bioskop" prefWidth="130.0"/>
            <TableColumn fx:id="studioColumn" text="Studio" prefWidth="80.0"/>
            <TableColumn fx:id="jadwalColumn" text="Jadwal Tayang" prefWidth="150.0"/>
            <TableColumn fx:id="jumlahColumn" text="Jumlah Tiket" prefWidth="90.0"/>
            <TableColumn fx:id="totalColumn" text="Total Harga" prefWidth="120.0"/>
         </columns>
      </TableView>
      <HBox alignment="CENTER_RIGHT">
         <Button text="Cetak / Lihat Struk Tiket" onAction="#handleCetakTiket" styleClass="button"/>
      </HBox>
   </children>
</VBox>