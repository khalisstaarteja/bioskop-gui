<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.FilmTableController">
    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
    <children>
        <VBox styleClass="form-card">
            <children>
                <HBox spacing="25.0" alignment="TOP_LEFT">
                    <GridPane hgap="15.0" vgap="12.0" HBox.hgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                            <ColumnConstraints minWidth="100.0"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0"/>
                        </columnConstraints>
                        <children>
                            <Label text="Kode Film:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="kodeFilmField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Label text="Judul Film:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <TextField fx:id="judulField" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <Label text="Genre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="genreField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <Label text="Durasi (Menit):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <TextField fx:id="durasiField" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                            <Label text="Poster:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Button text="Pilih Gambar Poster" onAction="#handleChoosePoster" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <HBox spacing="10.0" alignment="CENTER_RIGHT" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                <Button onAction="#handleSubmit" styleClass="submit-btn" text="Submit" />
                                <Button onAction="#handleUpdate" styleClass="update-btn" text="Update" />
                                <Button onAction="#handleDelete" styleClass="delete-btn" text="Delete" />
                                <Button onAction="#clearForm" styleClass="clear-btn" text="Clear" />
                            </HBox>
                        </children>
                    </GridPane>

                    <StackPane styleClass="poster-small" minWidth="120.0" minHeight="160.0" prefWidth="120.0" prefHeight="160.0" maxWidth="120.0" maxHeight="160.0">
                        <ImageView fx:id="posterImageView" fitHeight="160.0" fitWidth="120.0" preserveRatio="false" />
                    </StackPane>
                </HBox>
            </children>
        </VBox>

        <TableView fx:id="filmTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn text="Kode Film"><cellValueFactory><PropertyValueFactory property="kodeFilm" /></cellValueFactory></TableColumn>
                <TableColumn text="Judul"><cellValueFactory><PropertyValueFactory property="judul" /></cellValueFactory></TableColumn>
                <TableColumn text="Genre"><cellValueFactory><PropertyValueFactory property="genre" /></cellValueFactory></TableColumn>
                <TableColumn text="Durasi"><cellValueFactory><PropertyValueFactory property="durasi" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="posterColumn" text="Poster"><cellValueFactory><PropertyValueFactory property="poster" /></cellValueFactory></TableColumn>
            </columns>
        </TableView>
        <HBox spacing="10.0" alignment="CENTER_RIGHT">
            <Button onAction="#handleViewDetails" text="View Details" />
        </HBox>
    </children>
</VBox>