<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.controller.UserTableController">
    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
    <children>
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Nama:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="namaField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="roleComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <!-- dynamic container untuk username admin / email pelanggan -->
                <VBox fx:id="dynamicFormContainer" spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2" />

                <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Button onAction="#handleSubmit" text="Submit" />
                    <Button onAction="#handleUpdate" text="Update" />
                    <Button onAction="#handleDelete" text="Delete" />
                </HBox>
            </children>
        </GridPane>

        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="ID"><cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory></TableColumn>
                <TableColumn text="Nama"><cellValueFactory><PropertyValueFactory property="nama" /></cellValueFactory></TableColumn>
                <TableColumn text="Role"><cellValueFactory><PropertyValueFactory property="role" /></cellValueFactory></TableColumn>
                <TableColumn fx:id="extraColumn" text="Detail Spesifik" />
            </columns>
        </TableView>
    </children>
</VBox>