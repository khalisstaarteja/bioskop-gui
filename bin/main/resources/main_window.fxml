<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="1000.0" 
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="main.java.controller.MainWindowController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Master Data">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleOpenBioskop" text="Bioskop" />
                <MenuItem mnemonicParsing="false" onAction="#handleOpenStudio" text="Studio" />
                <MenuItem mnemonicParsing="false" onAction="#handleOpenFilm" text="Film" />
                <MenuItem mnemonicParsing="false" onAction="#handleOpenJadwal" text="Jadwal Tayang" />
                <MenuItem mnemonicParsing="false" onAction="#handleOpenUser" text="User &amp; Pelanggan" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Transaksi">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleOpenPemesanan" text="Pemesanan Tiket" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Akun">
            <items>
                <MenuItem mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
                <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <!-- Tempat tab dinamis terbuka saat menu diklik -->
      <TabPane fx:id="mainTabPane" BorderPane.alignment="CENTER" tabClosingPolicy="ALL_TABS"/>
   </center>
</BorderPane>